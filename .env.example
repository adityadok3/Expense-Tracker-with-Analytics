# Database Configuration
# For PostgreSQL: postgresql://postgres:postgres@localhost:5432/expensetracker?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/expensetracker?schema=public"

# Application Server Config
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# JWT Authentication Secrets
JWT_SECRET=super_secret_jwt_access_key_change_in_production_2026
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=super_secret_jwt_refresh_key_change_in_production_2026
JWT_REFRESH_EXPIRES_IN=7d

# Google Generative AI API Key (For AI Advisor feature)
GOOGLE_API_KEY=your_google_genai_api_key_here

# Optional Cloudinary Config (If omitted, local disk storage is used)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
